# SCM MCP Server — 环境变量示例
# 复制为 .env 后填入真实值，不要把真实凭据提交到代码库。

# SCM OAuth2 凭据（必填）
# 在 SCM 控制台 → IAM → Service Accounts 创建服务账号后获取。
SCM_CLIENT_ID=your-client-id-here
SCM_CLIENT_SECRET=your-client-secret-here

# Tenant Service Group ID（必填）
# 在 SCM 控制台 → Tenant Service Groups 中查看。
SCM_TSG_ID=your-tsg-id-here

# SCM API 端点（可选，使用默认值即可）
SCM_BASE_URL=https://api.strata.paloaltonetworks.com
SCM_AUTH_URL=https://auth.apps.paloaltonetworks.com
